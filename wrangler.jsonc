{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goalkeep-v5",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's own Workers entry — not the Node build output.
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // Contact form enquiries, newsletter sign-ups and quiz responses. v5.0-draft
  // has its own database so review traffic never mixes with goalkeep-v4's
  // production data. Schema in migrations/; apply with
  // `wrangler d1 migrations apply goalkeep-site-v5 --remote`.
  // Who gets an email for each contact enquiry (comma-separated), and the
  // sender, on the Resend-verified mail.goalkeep.org domain. The Resend API
  // key is a secret: `wrangler secret put RESEND_API_KEY`, or .dev.vars locally.
  "vars": {
    "CONTACT_EMAIL_FROM": "Goalkeep website <website@mail.goalkeep.org>",
    "CONTACT_EMAIL_TO": "aditya@goalkeep.net,mohithkumar808@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goalkeep-site-v5",
      "database_id": "aa88e92e-28ec-4c7c-b5fd-ecabd6effd0d",
      "migrations_dir": "migrations"
    }
  ]
}
