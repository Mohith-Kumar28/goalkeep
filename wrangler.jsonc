{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goalkeep-v5",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's own Workers entry — not the Node build output.
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // Contact form enquiries, newsletter sign-ups and quiz responses. v5.0-draft
  // has its own database so review traffic never mixes with goalkeep-v4's
  // production data. Schema in migrations/; apply with
  // `wrangler d1 migrations apply goalkeep-site-v5 --remote`.
  // Who gets an email for each contact enquiry (comma-separated), and the
  // sender, on the Resend-verified mail.goalkeep.org domain. The Resend API
  // key is a secret: `wrangler secret put RESEND_API_KEY`, or .dev.vars locally.
  // Newsletter sign-ups and quiz responses download as CSV from
  // /api/export/newsletter.csv?token=… and /api/export/quiz.csv?token=…,
  // where the token is the EXPORT_TOKEN secret: `wrangler secret put
  // EXPORT_TOKEN`, or .dev.vars locally. Without it both routes answer 404.
  // The contact form and the quiz also add their submitter to Goalkeep's
  // Mailchimp audience; newsletter sign-ups stay in D1 only (Nov 11). With
  // `wrangler secret put MAILCHIMP_API_KEY` (a Marketing API key, "…-us8") and
  // `wrangler secret put MAILCHIMP_LIST_ID` (the audience id) it uses the API
  // and tags each member by form; without them it posts to the audience's
  // public sign-up form, untagged. Local dev never calls Mailchimp.
  // The quiz results email sends from no-reply on the Resend-verified
  // mail.goalkeep.org; anyone who replies anyway reaches Aditya through
  // QUIZ_REPLY_TO.
  "vars": {
    "CONTACT_EMAIL_FROM": "Goalkeep website <website@mail.goalkeep.org>",
    "CONTACT_EMAIL_TO": "aditya@goalkeep.net,mohithkumar808@gmail.com",
    "QUIZ_EMAIL_FROM": "Goalkeep <no-reply@mail.goalkeep.org>",
    "QUIZ_REPLY_TO": "aditya@goalkeep.org"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goalkeep-site-v5",
      "database_id": "aa88e92e-28ec-4c7c-b5fd-ecabd6effd0d",
      "migrations_dir": "migrations"
    }
  ]
}
